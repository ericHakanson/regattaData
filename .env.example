# regattaData environment — copy to `.env` and fill in.
# `.env` (and every `.env.*` except this template) is git-ignored — see .gitignore —
# so your real Neon credentials never get committed. Never remove that ignore rule.
#
# Primary database is Neon (serverless PostgreSQL). Everything in this repo
# (the `regatta-import` CLI and scripts/) reads a single DSN from `DB_DSN`.
#
# Neon connection string (get it from the Neon console → project → Connection Details):
#   postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
DB_DSN="postgresql://USER:PASSWORD@EP-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Legacy Google Cloud SQL (fallback only, being decommissioned) ---
# The old path reached Cloud SQL through cloud-sql-proxy on 127.0.0.1:5433 via
# scripts/dev_start_proxy.sh + ~/.pgpass. Kept only as a read-only fallback during
# the Neon soak window; do not use for new work. See docs/runbooks/10-neon-operations.md.
# DB_DSN="postgresql://regatta_app@127.0.0.1:5433/regatta_data"

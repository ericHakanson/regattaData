# Environment variables — never commit real secrets (e.g. Neon DB_DSN).
# Ignore every .env variant, but keep the committed template .env.example.
.env
.env.*
.env.local
/env
env.*
!.env.example

# Supabase
.supabase/

# OS
.DS_Store

# Raw evidence exports
rawEvidence/

# ETL artifacts
artifacts/rejects/*
!artifacts/rejects/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
artifacts/qa/*
!artifacts/qa/.gitkeep
artifacts/exports/*
!artifacts/exports/.gitkeep
artifacts/logs/*
!artifacts/logs/.gitkeep

# Local audience dataset dumps
audience_export_*/
audience_export_*.zip

# Migration smoke logs
migrations/tests/logs/*
!migrations/tests/logs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/

# Local credential material
*.pem
*.p12
*.key
*.crt

# Ignore all CSV files
*.csv
